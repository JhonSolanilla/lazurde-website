{
  // Web de reservas de Lazurde Resort.
  // Cloudflare publica automáticamente cada cambio que se sube a GitHub.
  "name": "lazurde-website",
  "compatibility_date": "2026-10-01",
  // Servidor: API de reservas (/api/*) y panel (/admin)
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Base de datos de reservas (D1). Se activa cuando exista en Cloudflare:
  // ,"d1_databases": [{ "binding": "DB", "database_name": "lazurde-bookings", "database_id": "PEGAR-AQUI-EL-ID" }]
}
